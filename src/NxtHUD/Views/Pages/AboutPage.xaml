<Page
    x:Class="NxtHUD.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:NxtHUD.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="0,24,0,24">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{loc:Loc Nav_About}" />

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                Grid.Column="0"
                Width="64"
                Height="64"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="pack://application:,,,/Assets/Logo.png" />

            <StackPanel
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="NxtHUD" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc About_Version}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        Style="{StaticResource CardDescriptionStyle}"
                        Text="{Binding AppVersion, Mode=OneTime}" />
                </StackPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource CardTitleStyle}"
                    Text="{loc:Loc About_Description}" />
            </StackPanel>
        </Grid>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE895;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc About_Updates_Title}" />
                    <TextBlock
                        Style="{StaticResource CardDescriptionStyle}"
                        Text="{Binding UpdateStatusText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding OpenReleasePageCommand, Mode=OneTime}"
                    Content="{loc:Loc About_Updates_Download}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button
                    Margin="0,0,12,0"
                    Command="{Binding CheckForUpdatesNowCommand, Mode=OneTime}"
                    Content="{loc:Loc About_Updates_CheckNow}" />
                <ui:ToggleSwitch IsChecked="{Binding CheckForUpdates}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE8B7;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc About_SettingsFile_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{Binding SettingsFilePath, Mode=OneTime}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Click="OnOpenSettingsFolderClick" Content="{loc:Loc About_OpenFolder}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:FontIcon Glyph="&#xE777;" Style="{StaticResource CardIconStyle}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{loc:Loc About_Reset_Title}" />
                    <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="{loc:Loc About_Reset_Description}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Command="{Binding ResetToDefaultsCommand, Mode=OneTime}" Content="{loc:Loc About_Reset_Button}" />
        </ui:CardControl>
    </StackPanel>
</Page>
